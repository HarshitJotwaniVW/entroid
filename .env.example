# Copy to .env.local for local development, and set the same keys in the
# Vercel project settings. Nothing here has a safe default.
#
# .env.local is gitignored (it matches *.local) — never commit real keys.

# ── Canonical origin ─────────────────────────────────────────────
# Every canonical tag, sitemap entry, llms.txt link, open-graph image URL and
# schema.org @id is built from this, AT BUILD TIME — so it must be set before
# `next build` runs, not just at runtime. In Vercel, scope it to Production.
# Without it the build falls back to VERCEL_PROJECT_PRODUCTION_URL, which is
# stable and upgrades itself when a custom domain is attached, so this is an
# override rather than a requirement. Never point it at a preview URL.
NEXT_PUBLIC_SITE_URL=https://entroid-website.vercel.app

# ── Demo request form (/contact -> /api/contact) ─────────────────
# Until all three are set the endpoint answers 503 and the form shows the
# direct email address instead, so the page still works.
#
# 1. RESEND_API_KEY — resend.com/api-keys. "Sending access" permission is
#    enough; it does not need full access.
# 2. CONTACT_TO_EMAIL — where enquiries land. Any address; the receiving side
#    needs no setup.
# 3. CONTACT_FROM_EMAIL — the sender. This MUST be on a domain verified at
#    resend.com/domains (add the DKIM/SPF records it gives you). Resend
#    rejects a from-address on any unverified domain, including gmail.com.
#    For a first test before the domain is verified, Resend allows
#    onboarding@resend.dev — but it can only deliver to the email address
#    that owns the Resend account.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
